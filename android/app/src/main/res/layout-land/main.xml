<!-- Cyber Engine :: LANDSCAPE layout
     Three-column grid per FASE 1 spec.
       NAV | 3D VIEW | SYSTEM/PROCESSES/FILES
           | TERMINAL + AUTOMATION
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cyber_bg">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:background="@color/cyber_panel"
        android:gravity="center_vertical"
        android:padding="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_title"
            android:textColor="@color/cyber_cyan"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/hud"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/cyber_lime"
            android:textSize="10sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Body: 3 columns -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Left column: NAV (vertical) -->
        <ScrollView
            android:layout_width="80dp"
            android:layout_height="match_parent"
            android:background="@color/cyber_panel_dark"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/sidebar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <!-- Middle column: 3D VIEW (top) + row of TERMINAL | AUTOMATION -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:orientation="vertical">

            <com.cyberengine.app.CyberSurfaceView
                android:id="@+id/surfaceView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/cyber_viewport_bg" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <com.cyberengine.app.TerminalView
                    android:id="@+id/terminalView"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2"
                    android:background="@color/cyber_terminal_bg"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/automationText"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:padding="6dp"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:textColor="@color/cyber_red"
                    android:textSize="9sp"
                    android:background="@color/cyber_panel"
                    android:text="AUTOMATION\nNOT_IMPLEMENTED\n(spec §10)" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right column: SYSTEM / CAPABILITIES / NETWORK / BOOT stacked -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@color/cyber_panel_dark">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="2">
                <TextView
                    android:id="@+id/systemText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="6dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/cyber_lime"
                    android:textSize="9sp" />
            </ScrollView>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:id="@+id/capabilitiesText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="6dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/cyber_cyan"
                    android:textSize="8sp" />
            </ScrollView>

            <TextView
                android:id="@+id/networkText"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="4dp"
                android:fontFamily="monospace"
                android:textColor="@color/cyber_red"
                android:textSize="9sp"
                android:background="@color/cyber_panel"
                android:text="NETWORK.OBSERVATION\nNOT_IMPLEMENTED" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:id="@+id/bootText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/cyber_amber"
                    android:textSize="8sp" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
